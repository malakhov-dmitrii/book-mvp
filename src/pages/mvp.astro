---
import Base from '../layouts/Base.astro';
import { marked } from 'marked';
import fs from 'node:fs';
import path from 'node:path';

// Read MVP markdown bundled in src/content
const mdPath = path.resolve(process.cwd(), 'src/content/kniga-mvp-v0.1.md');
const raw = fs.readFileSync(mdPath, 'utf-8');

// Strip everything up to and including the first horizontal rule
// (front matter is the title + subtitle + intro paragraphs, which we render
// statically in the page header).
const md = raw.replace(/^[\s\S]*?\n---\s*\n/, '').trim();

// Extract H2s for TOC
const h2Matches = [...md.matchAll(/^##\s+(.+)$/gm)];
const tocItems = h2Matches.map((m, i) => ({
  text: m[1].trim(),
  slug: `ch-${i}`,
}));

// Render markdown, then add IDs to H2s
let counter = 0;
const html = marked.parse(md, { breaks: false, gfm: true }).replace(
  /<h2>/g,
  () => `<h2 id="ch-${counter++}">`,
);
---
<Base title="Что в тебе твоё? — MVP" currentPage="mvp" showProgress={true}>
  <div class="reader-layout">
    <aside class="toc" id="toc">
      <h3>// Содержание</h3>
      <ol>
        {tocItems.map((item, i) => (
          <li class={i === 0 ? 'active' : ''} data-target={item.slug}>
            <a href={`#${item.slug}`}>{item.text}</a>
          </li>
        ))}
      </ol>
    </aside>

    <article class="content">
      <div class="reader-header">
        <h1>ЧТО В ТЕБЕ ТВОЁ?</h1>
        <p class="subtitle">О свободе воли, гордыне, сострадании и том, что проходит через нас</p>
        <p class="meta">// Короткая версия — 20 минут чтения</p>
      </div>

      <div class="audio-block">
        <p class="label">// Прослушать</p>
        <div id="elevenlabs-audionative-widget" data-height="90" data-width="100%" data-frameborder="no" data-scrolling="no" data-publicuserid="bfa58ed8d83314dba6cdd7323ad8b40313a36e867c4cfcf1da162b69977462e1" data-playerurl="https://elevenlabs.io/player/index.html">Loading the <a href="https://elevenlabs.io/text-to-speech" target="_blank" rel="noopener">Elevenlabs Text to Speech</a> AudioNative Player...</div>
        <script is:inline src="https://elevenlabs.io/player/audioNativeHelper.js" type="text/javascript"></script>
      </div>

      <div class="prose" set:html={html} />
    </article>
  </div>

  <script is:inline>
    // TOC active state via IntersectionObserver
    (function () {
      const toc = document.getElementById('toc');
      if (!toc) return;
      const items = Array.from(toc.querySelectorAll('li[data-target]'));
      const headings = items
        .map((li) => {
          const id = li.getAttribute('data-target');
          return { li, el: document.getElementById(id) };
        })
        .filter((x) => x.el);

      if (headings.length === 0) return;

      function setActive(slug) {
        items.forEach((li) => {
          li.classList.toggle('active', li.getAttribute('data-target') === slug);
        });
      }

      let current = headings[0].el.id;
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              current = entry.target.id;
              setActive(current);
            }
          });
        },
        { rootMargin: '-80px 0px -60% 0px', threshold: 0 },
      );

      headings.forEach(({ el }) => observer.observe(el));

      // Smooth scroll already handled by CSS scroll-behavior: smooth
    })();
  </script>
</Base>
